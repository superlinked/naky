{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/superlinked/naky/blob/main/evals/aggregate-results.schema.json",
  "title": "Näky public evaluation aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "dataset",
    "reader_policy",
    "screenshot_policy",
    "product_source",
    "product",
    "cohorts",
    "results",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "naky.public-eval-aggregate.v1"},
    "status": {"enum": ["pending", "complete"]},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "split"],
      "properties": {
        "name": {"const": "ONE-Lab/GUI-World"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "split": {"const": "benchmark"}
      }
    },
    "reader_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort", "max_output_tokens", "image_detail", "service_tier", "store", "trials"],
      "properties": {
        "model": {"const": "gpt-6-luna"},
        "reasoning_effort": {"const": "low"},
        "max_output_tokens": {"const": 16384},
        "image_detail": {"const": "high"},
        "service_tier": {"const": "high"},
        "store": {"const": false},
        "trials": {"const": 3}
      }
    },
    "screenshot_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frames", "long_edge_pixels", "sampling"],
      "properties": {
        "frames": {"const": 20},
        "long_edge_pixels": {"const": 768},
        "sampling": {"const": "nearest-equal-presentation-duration-bin-midpoint"}
      }
    },
    "product_source": {"$ref": "#/$defs/nullableProductSource"},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scored_binary_sha256",
        "equivalence_execution_binary",
        "release_binary",
        "model_manifest",
        "model_archive",
        "equivalence_receipt"
      ],
      "properties": {
        "scored_binary_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "equivalence_execution_binary": {"$ref": "#/$defs/nullableIdentity"},
        "release_binary": {"$ref": "#/$defs/nullableIdentity"},
        "model_manifest": {"$ref": "#/$defs/nullableIdentity"},
        "model_archive": {"$ref": "#/$defs/nullableIdentity"},
        "equivalence_receipt": {"$ref": "#/$defs/nullableIdentity"}
      }
    },
    "cohorts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "definition", "records", "valid_tasks", "media_clusters"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "definition": {"type": "string", "minLength": 1, "maxLength": 500},
          "records": {"type": "integer", "minimum": 0},
          "valid_tasks": {"type": "integer", "minimum": 0},
          "media_clusters": {"type": "integer", "minimum": 0}
        }
      }
    },
    "results": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cohort", "slice", "metric", "value", "sample_size", "unit"],
        "properties": {
          "cohort": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "slice": {"type": "string", "minLength": 1, "maxLength": 100},
          "metric": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "value": {"type": "number"},
          "sample_size": {"type": "integer", "minimum": 0},
          "ci95_low": {"type": "number"},
          "ci95_high": {"type": "number"},
          "unit": {"type": "string", "maxLength": 32}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "nullableIdentity": {
      "oneOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]
    },
    "productSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "files", "bytes", "sha256"],
      "properties": {
        "algorithm": {"const": "sha256(canonical-json-public-product-source-v1)"},
        "files": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "nullableProductSource": {
      "oneOf": [{"$ref": "#/$defs/productSource"}, {"type": "null"}]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}},
      "then": {
        "properties": {
          "product_source": {"$ref": "#/$defs/productSource"},
          "product": {
            "properties": {
              "scored_binary_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "equivalence_execution_binary": {"$ref": "#/$defs/identity"},
              "release_binary": {"$ref": "#/$defs/identity"},
              "model_manifest": {"$ref": "#/$defs/identity"},
              "model_archive": {"$ref": "#/$defs/identity"},
              "equivalence_receipt": {"$ref": "#/$defs/identity"}
            }
          },
          "cohorts": {"minItems": 1},
          "results": {"minItems": 1}
        }
      }
    }
  ]
}
